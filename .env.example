# ============================================================
# CloudAgent 配置
# ============================================================

# ===== LLM 服务（OpenAI 兼容）=====
CLOUDAGENT_BASE_URL=https://api.deepseek.com/v1
CLOUDAGENT_API_KEY=sk-your-real-key
CLOUDAGENT_MODEL=deepseek-chat

# ===== Agent 运行参数（可选） =====
CLOUDAGENT_AUTO_APPROVE_SHELL=false

# ===== 服务端口 =====
CLOUDAGENT_PORT=3801
