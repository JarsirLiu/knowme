# ============================================================
# SuperAgent 模型配置
# 用法：复制本文件为 .env，填入你自己的值
#   cp .env.example .env
# 所有键值均通过环境变量注入，源码中不含任何模型硬编码
# ============================================================

# ===== 必填：模型服务（OpenAI 兼容，仅 chat/completions 协议）=====
# 模型服务地址
SUPERAGENT_BASE_URL=https://api.deepseek.com/v1
# API Key（本地服务如 Ollama / LM Studio 可随意填写，例如 sk-local）
SUPERAGENT_API_KEY=sk-your-real-key
# 模型名称（需支持 function calling / tool calls）
SUPERAGENT_MODEL=deepseek-chat

# ===== 可选：运行参数（不填则用下方默认值）=====
# agent 可操作的根目录（文件工具被限制在此目录内，使用绝对路径）
SUPERAGENT_WORKSPACE=D:/your/project
# 设为 true 则 shell 命令不再需要人工审批（生产环境不建议）
SUPERAGENT_AUTO_APPROVE=false
# 单次对话最大轮数
SUPERAGENT_MAX_TURNS=25
# Web 服务监听端口
SUPERAGENT_PORT=3800

# ===== 常见服务地址参考（取消注释并替换上面的值即可）=====
# Ollama:          SUPERAGENT_BASE_URL=http://localhost:11434/v1
# LM Studio:       SUPERAGENT_BASE_URL=http://localhost:1234/v1
# vLLM:            SUPERAGENT_BASE_URL=http://localhost:8000/v1
# 硅基流动:         SUPERAGENT_BASE_URL=https://api.siliconflow.cn/v1
# 通义(兼容模式):    SUPERAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
