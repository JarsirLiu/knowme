generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data.db"
}

model Session {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  messages  Message[]
  toolCalls ToolCall[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ToolCall {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  args      String
  status    String   @default("running")
  result    String?
  error     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Device {
  id        String   @id @default(cuid())
  name      String
  endpoint  String
  apiKey    String
  status    String   @default("offline")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}