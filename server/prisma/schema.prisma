generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data.db"
}

model Project {
  id            String         @id @default(cuid())
  name          String
  rootPath      String         @unique
  settingsJson  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model Conversation {
  id           String        @id @default(cuid())
  projectId    String
  title        String
  status       String        @default("active")
  agentProfile String        @default("coding")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  nextRunSequence Int        @default(0)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentSession AgentSession?
  messages     Message[]
  runs         AgentRun[]
  timelineSequence TimelineSequence?
  timelineEvents TimelineEvent[]

  @@index([projectId, updatedAt])
}

model AgentSession {
  id             String       @id @default(cuid())
  conversationId String       @unique
  sessionKey     String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  items          SessionItem[]
}

model SessionItem {
  id        String       @id @default(cuid())
  sessionId String
  sequence  Int
  itemType  String
  payload   String
  createdAt DateTime     @default(now())
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, sequence])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  runId          String?
  role           String
  content        String
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            AgentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model AgentRun {
  id              String        @id @default(cuid())
  conversationId  String
  clientMessageId String?
  sequence        Int           @default(0)
  status          String        @default("queued")
  input           String
  output          String?
  state           String?
  error           String?
  attempt         Int           @default(0)
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  cancelRequestedAt DateTime?
  lastHeartbeatAt DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime      @default(now())
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages        Message[]
  events          RunEvent[]
  approvals       Approval[]
  artifacts       Artifact[]
  timelineEvents  TimelineEvent[]

  @@index([conversationId, createdAt])
  @@index([conversationId, clientMessageId])
  @@index([status, createdAt])
  @@index([leaseExpiresAt])
  @@unique([clientMessageId])
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  sequence  Int
  type      String
  payload   String
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, sequence])
}

model TimelineSequence {
  conversationId String       @id
  nextSequence   Int          @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id             String       @id @default(cuid())
  conversationId String
  runId          String?
  sequence       Int
  type           String
  payload        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            AgentRun?    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, sequence])
  @@index([runId, sequence])
}

model Approval {
  id         String   @id @default(cuid())
  runId      String
  toolCallId String   @unique
  toolName   String
  arguments  String
  status     String   @default("pending")
  decision   String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Artifact {
  id             String   @id @default(cuid())
  runId          String?
  fileName       String
  mimeType       String?
  size           Int?
  sha256         String?
  localPath      String
  status         String   @default("ready")
  createdAt      DateTime @default(now())
  run            AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
}

model Device {
  id        String   @id @default(cuid())
  name      String
  endpoint  String
  apiKey    String
  status    String   @default("offline")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
