{
  "name": "superagent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "fastify": "^5.3.2",
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.6.0",
    "dotenv": "^16.4.7",
    "@superagent/agent": "workspace:*",
    "@superagent/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}