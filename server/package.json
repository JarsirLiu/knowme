{
  "name": "cloudagent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc",
    "test": "node scripts/run-tests.mjs",
    "start": "node dist/index.js",
    "db:generate": "tsx scripts/prisma-cli.ts generate --schema prisma/schema.prisma",
    "db:push": "tsx scripts/prisma-cli.ts db push --schema prisma/schema.prisma",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "fastify": "^5.3.2",
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "6.19.3",
    "@openai/agents": "0.15.0",
    "dotenv": "^16.4.7",
    "@cloudagent/agent": "workspace:*",
    "@cloudagent/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
